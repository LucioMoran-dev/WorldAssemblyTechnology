# ========================================
# CONFIGURACIÓN DEL FRONTEND
# ========================================

# Backend API URL
# El backend corre en el puerto 3001 por defecto
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend URL (para OAuth callback y redirecciones)
# El frontend (Next.js) corre en el puerto 3000 por defecto
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Puerto del frontend (Next.js)
# Cambiar si el puerto 3000 está ocupado
PORT=3000

# ========================================
# NOTAS IMPORTANTES
# ========================================
#
# - Backend API: http://localhost:3001
# - Frontend: http://localhost:3000
# - Swagger Docs: http://localhost:3001/api/docs
# - CORS configurado para: localhost:3000, localhost:5173
#
# Para producción, actualiza las URLs según tu dominio
